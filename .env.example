# ==========================================================
# Plantilla de configuración de LectoEscritura (EVAL)
# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env nunca se versiona.
# ==========================================================

# --- Base de datos MySQL ---
#
# OPCIÓN A — MySQL local de XAMPP (recomendado para desarrollo):
#   DB_HOST=127.0.0.1
#   DB_SSL=0
#   El MySQL de XAMPP tiene SSL deshabilitado (have_ssl=DISABLED), por
#   eso la conexión NO debe forzarlo.
#
# OPCIÓN B — MySQL de Azure:
#   DB_HOST=<servidor>.mysql.database.azure.com
#   DB_SSL=1
#   Azure exige conexión cifrada y que la IP del equipo esté en el
#   allowlist de firewall del servidor.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_SSL=0

# --- Inteligencia artificial (Gemini) ---
# Creá la key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Aplicación ---
APP_TIMEZONE=America/Bogota
