# ==========================================================
# Plantilla de configuración de LectoEscritura (EVAL)
# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env nunca se versiona.
# ==========================================================

# --- Base de datos MySQL (Azure) ---
# El servidor exige SSL. La IP de tu equipo debe estar en el
# "allowlist" de firewall del servidor MySQL de Azure.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# --- Inteligencia artificial (Gemini) ---
# Creá la key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Aplicación ---
APP_TIMEZONE=America/Bogota
